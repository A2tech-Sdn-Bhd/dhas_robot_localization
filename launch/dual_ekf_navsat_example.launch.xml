<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <!-- Package share directory for robot_localization -->
  <let name="robot_localization_dir" value="$(find-pkg-share robot_localization)" />
  <let name="parameters_file_dir" value="$(var robot_localization_dir)/params" />
  <let name="parameters_file_path" value="$(var parameters_file_dir)/dual_ekf_navsat_example.yaml" />

  <!-- Launch arguments -->
  <arg name="output_final_position" default="false" />
  <arg name="output_location" default="~/dual_ekf_navsat_example_debug.txt" />

  <!-- EKF filter node for odometry -->
  <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node_odom" output="screen">
    <param from="$(var parameters_file_path)" />
    <remap from="odometry/filtered" to="odometry/local" />
  </node>

  <!-- EKF filter node for map -->
  <node pkg="robot_localization" exec="ekf_node" name="ekf_filter_node_map" output="screen">
    <param from="$(var parameters_file_path)" />
    <remap from="odometry/filtered" to="odometry/global" />
  </node>

  <!-- NavSat transform node -->
  <node pkg="robot_localization" exec="navsat_transform_node" name="navsat_transform" output="screen">
    <param from="$(var parameters_file_path)" />
    <remap from="imu/data" to="imu/data" />
    <remap from="gps/fix" to="gps/fix" />
    <remap from="gps/filtered" to="gps/filtered" />
    <remap from="odometry/gps" to="odometry/gps" />
    <remap from="odometry/filtered" to="odometry/global" />
  </node>

</launch>
