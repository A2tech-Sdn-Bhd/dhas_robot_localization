<launch>
  <!-- Launch arguments -->
  <arg name="output_final_position" default="false"/>
  <arg name="output_location" default="~/dual_ekf_navsat_example_debug.txt"/>

  <!-- EKF node for map/global frame -->
  <node
    pkg="robot_localization"
    exec="ekf_node"
    name="ekf_filter_node_map"
    output="screen">

    <!-- Load parameters from YAML -->
    <param from="$(find-pkg-share robot_localization)/params/dhas_dual_ekf_navsat.yaml"/>

    <!-- Remappings -->
    <remap from="odometry/filtered" to="odometry/global"/>
  </node>

  <!-- Navsat transform node -->
  <node
    pkg="robot_localization"
    exec="navsat_transform_node"
    name="navsat_transform"
    output="screen">

    <!-- Load parameters from YAML -->
    <param from="$(find-pkg-share robot_localization)/params/dhas_dual_ekf_navsat.yaml"/>

    <!-- Remappings -->
    <remap from="imu" to="rtk_heading/imu"/>
    <remap from="gps/fix" to="gps/rover/fix"/>
    <remap from="gps/filtered" to="gps/filtered"/>
    <remap from="odometry/gps" to="odometry/gps"/>
    <remap from="odometry/filtered" to="odometry/global"/>
  </node>

  <!-- RViz2 -->
  <node
    pkg="rviz2"
    exec="rviz2"
    name="rviz2"
    output="screen"
    args="-d /home/leggeed/dhas_dev_ws/src/dhas_nodes/rviz/localization.rviz">

    <param name="use_sim_time" value="true"/>
  </node>

  <!--
  If you want to enable the odom EKF as well, uncomment this block:

  <node
    pkg="robot_localization"
    exec="ekf_node"
    name="ekf_filter_node_odom"
    output="screen">
    <param from="$(find-pkg-share robot_localization)/params/dhas_dual_ekf_navsat.yaml"/>
    <remap from="odometry/filtered" to="odometry/local"/>
  </node>
  -->

</launch>
